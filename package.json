{
  "name": "opentelemetry-ecosystem-explorer",
  "version": "0.0.0",
  "private": true,
  "description": "OpenTelemetry Ecosystem Explorer - discover and explore OpenTelemetry ecosystem projects",
  "scripts": {
    "lint": "bun run lint:md && cd ecosystem-explorer && bun run lint",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
