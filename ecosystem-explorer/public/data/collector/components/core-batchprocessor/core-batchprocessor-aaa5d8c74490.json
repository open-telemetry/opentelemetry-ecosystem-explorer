          "value_type": "int"
        },
        "stability": "development",
        "unit": "{unit}"
      },
      "processor_batch_batch_send_size_bytes": {
        "description": "Number of bytes in batch that was sent. Only available on detailed level.",
        "enabled": true,
        "histogram": {
          "bucket_boundaries": [
            128,
            256,
            512,
            1024,
            2048,
            4096,
            8192,
            16384,
            32768,
            65536,
            131072,
            262144,
            524288,
            1048576,
            2097152,
            4194304,
            8388608,
            16777216
          ],
          "value_type": "int"
