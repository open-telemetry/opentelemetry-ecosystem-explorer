  "description": "The MongoDB Atlas Receiver receives metrics from [MongoDB Atlas](https://www.mongodb.com/cloud/atlas) via their [monitoring APIs](https://docs.atlas.mongodb.com/reference/api/monitoring-and-logs/), as well as alerts via a configured [webhook](https://www.mongodb.com/docs/atlas/tutorial/third-party-service-integrations/) and events from [events APIs](https://www.mongodb.com/docs/atlas/reference/api/events/).",
  "display_name": "MongoDB Atlas Receiver",
  "distribution": "contrib",
  "ecosystem": "collector",
  "id": "contrib-mongodbatlasreceiver",
  "markdown_hash": "3ed0141e1849",
