        "stability": "development",
        "sum": {
          "monotonic": true,
          "value_type": "int"
        },
        "unit": "1"
      },
      "processor_groupbytrace_traces_released": {
        "description": "Traces released to the next consumer",
        "enabled": true,
        "stability": "development",
        "sum": {
          "monotonic": true,
          "value_type": "int"
        },
