        "attributes": [
          "node_id",
          "outcome",
          "partition",
          "server.address",
          "topic"
        ],
        "description": "The uncompressed size in bytes of exported messages seen by the client.",
        "enabled": true,
        "stability": "development",
        "sum": {
          "monotonic": true,
          "value_type": "int"
        },
        "unit": "By"
      },
