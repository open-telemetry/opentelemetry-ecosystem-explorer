    {
      "declarative_name": "java.common.messaging.headers.excluded",
      "default": "",
      "description": "A comma-separated list of case-sensitive message header name glob patterns to exclude from span attributes. `?` matches one character and `*` matches zero or more characters. Excluded patterns take precedence over included patterns. An absent or empty selector captures no headers; an exclude-only selector captures every header not excluded, which may expose sensitive information.",
      "name": "otel.instrumentation.common.messaging.headers.excluded",
      "type": "list"
    },
    {
      "declarative_name": "java.common.messaging.headers.included",
      "default": "",
      "description": "A comma-separated list of case-sensitive message header name glob patterns to capture as span attributes. `?` matches one character and `*` matches zero or more characters. Excluded patterns take precedence over included patterns. An absent or empty selector captures no headers; an exclude-only selector captures every header not excluded.",
      "name": "otel.instrumentation.common.messaging.headers.included",
      "type": "list"
    },
    {
      "declarative_name": "java.rocketmq_client.experimental_span_attributes/development",
      "default": false,
      "description": "Enables capturing experimental span attributes `messaging.rocketmq.message.tag`, `messaging.rocketmq.broker_address`, `messaging.rocketmq.send_result`, `messaging.rocketmq.queue_id`, and `messaging.rocketmq.queue_offset`.",
      "name": "otel.instrumentation.rocketmq-client.experimental-span-attributes",
      "type": "boolean"
    },
    {
      "declarative_name": "java.rocketmq_client.message_create_spans.enabled",
      "default": true,
      "description": "Enables per-message Create spans for batch sends when stable messaging semantic conventions are enabled. Overrides the common messaging setting. Disabling this retains Send spans and context propagation and does not affect single-message sends.",
      "name": "otel.instrumentation.rocketmq-client.message-create-spans.enabled",
      "type": "boolean"
    }
