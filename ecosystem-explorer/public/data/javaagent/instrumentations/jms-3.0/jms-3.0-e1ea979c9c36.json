            },
            {
              "name": "messaging.system",
              "type": "STRING"
            }
          ],
          "data_type": "HISTOGRAM",
          "description": "Duration of messaging operation initiated by a producer or consumer client.",
          "instrument": "histogram",
          "name": "messaging.client.operation.duration",
          "unit": "s"
        },
        {
