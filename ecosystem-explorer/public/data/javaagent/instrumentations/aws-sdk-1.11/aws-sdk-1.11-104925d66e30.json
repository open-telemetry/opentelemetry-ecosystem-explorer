{
  "configurations": [
    {
      "declarative_name": "java.common.messaging.message_create_spans.enabled",
      "default": true,
      "description": "Provides the default for whether to create a producer span for each eligible message in a batch send when stable messaging semantic conventions are enabled. An instrumentation-specific setting takes precedence.",
      "name": "otel.instrumentation.common.messaging.message-create-spans.enabled",
      "type": "boolean"
    },
    {
      "declarative_name": "java.common.messaging.capture_headers/development",
      "default": "",
      "deprecated": true,
      "description": "Deprecated: use `otel.instrumentation.common.messaging.headers.included` instead. Ignored without a warning under v3-preview; may be removed in a later minor release and will be removed no later than 3.0. A comma-separated list of header names to capture as span attributes. It does not support glob patterns: an entry containing `*` or `?` is ignored with a warning, and every other entry is matched as a literal header name.",
      "name": "otel.instrumentation.messaging.experimental.capture-headers",
      "replaced_by": "otel.instrumentation.common.messaging.headers.included",
      "type": "list"
    },
    {
      "default": "",
      "deprecated": true,
      "description": "Deprecated: use `otel.instrumentation.common.messaging.headers.excluded` instead. Ignored without a warning under v3-preview; may be removed in a later minor release and will be removed no later than 3.0.",
      "name": "otel.instrumentation.messaging.experimental.headers.excluded",
      "replaced_by": "otel.instrumentation.common.messaging.headers.excluded",
      "type": "list"
    },
    {
      "default": "",
      "deprecated": true,
      "description": "Deprecated: use `otel.instrumentation.common.messaging.headers.included` instead. Ignored without a warning under v3-preview; may be removed in a later minor release and will be removed no later than 3.0.",
      "name": "otel.instrumentation.messaging.experimental.headers.included",
      "replaced_by": "otel.instrumentation.common.messaging.headers.included",
      "type": "list"
    },
    {
      "default": false,
      "deprecated": true,
      "description": "Deprecated: use `otel.instrumentation.common.messaging.experimental.receive-telemetry.enabled` instead. It may be removed in the next minor release.",
      "name": "otel.instrumentation.messaging.experimental.receive-telemetry.enabled",
      "replaced_by": "otel.instrumentation.common.messaging.experimental.receive-telemetry.enabled",
      "type": "boolean"
    },
    {
      "declarative_name": "java.common.messaging.headers.excluded",
      "default": "",
      "description": "A comma-separated list of case-sensitive message header name glob patterns to exclude from span attributes. `?` matches one character and `*` matches zero or more characters. Excluded patterns take precedence over included patterns. An absent or empty selector captures no headers; an exclude-only selector captures every header not excluded, which may expose sensitive information.",
      "name": "otel.instrumentation.common.messaging.headers.excluded",
      "type": "list"
    },
    {
      "declarative_name": "java.common.messaging.headers.included",
      "default": "",
      "description": "A comma-separated list of case-sensitive message header name glob patterns to capture as span attributes. `?` matches one character and `*` matches zero or more characters. Excluded patterns take precedence over included patterns. An absent or empty selector captures no headers; an exclude-only selector captures every header not excluded.",
      "name": "otel.instrumentation.common.messaging.headers.included",
      "type": "list"
    },
    {
      "declarative_name": "java.aws_sdk.experimental_span_attributes/development",
      "default": false,
      "description": "Enables the experimental span attributes `aws.agent`, `aws.queue.name`, `aws.lambda.function.arn` and `aws.lambda.function.name` for AWS SDK instrumentation.",
      "name": "otel.instrumentation.aws-sdk.experimental-span-attributes",
      "type": "boolean"
    },
    {
      "declarative_name": "java.aws_sdk.message_create_spans.enabled",
      "description": "Determines whether to create a producer span for each eligible message in an SQS batch send when stable messaging semantic conventions are enabled. Overrides `otel.instrumentation.common.messaging.message-create-spans.enabled` for this instrumentation; when unset, that setting applies.",
      "name": "otel.instrumentation.aws-sdk.message-create-spans.enabled",
      "type": "boolean"
    },
    {
      "declarative_name": "java.common.messaging.receive_telemetry/development.enabled",
      "default": false,
      "description": "Enables experimental receive telemetry, which will cause consumers to start a new trace, with only a span link connecting it to the producer trace.",
      "name": "otel.instrumentation.common.messaging.experimental.receive-telemetry.enabled",
      "type": "boolean"
    }
