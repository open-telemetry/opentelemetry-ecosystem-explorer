{
  "configurations": [
    {
      "declarative_name": "java.common.messaging.capture_headers/development",
      "default": "",
      "description": "Deprecated: use `otel.instrumentation.messaging.experimental.headers.included` instead. A comma-separated list of header names to capture as span attributes. It does not support glob patterns: an entry containing `*` or `?` is ignored with a warning, and every other entry is matched as a literal header name.",
      "name": "otel.instrumentation.messaging.experimental.capture-headers",
      "type": "list"
    },
    {
      "declarative_name": "java.common.messaging.headers/development.excluded",
      "default": "",
      "description": "A comma-separated list of message header name patterns to exclude from span attributes. Excluded patterns take precedence over included patterns. Matching is case-sensitive. `?` matches one character and `*` matches zero or more characters. If included is not configured, all non-excluded headers are captured, which may expose sensitive information.",
      "name": "otel.instrumentation.messaging.experimental.headers.excluded",
      "type": "list"
    },
    {
      "declarative_name": "java.common.messaging.headers/development.included",
      "default": "",
      "description": "A comma-separated list of message header name patterns to capture as span attributes. Matching is case-sensitive. `?` matches one character and `*` matches zero or more characters.",
      "name": "otel.instrumentation.messaging.experimental.headers.included",
      "type": "list"
    },
    {
      "declarative_name": "java.common.messaging.receive_telemetry/development.enabled",
      "default": false,
      "description": "Enables experimental receive telemetry, which will cause consumers to start a new trace, with only a span link connecting it to the producer trace.",
      "name": "otel.instrumentation.messaging.experimental.receive-telemetry.enabled",
      "type": "boolean"
    },
    {
      "declarative_name": "java.pulsar.experimental_span_attributes/development",
      "default": false,
      "description": "Enables the experimental span attribute `messaging.pulsar.message.type` for producer spans.",
      "name": "otel.instrumentation.pulsar.experimental-span-attributes",
      "type": "boolean"
    }
  ],
