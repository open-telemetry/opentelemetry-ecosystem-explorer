{
  "description": "This instrumentation enables messaging spans for Kafka Connect sink tasks.",
  "display_name": "Apache Kafka Connect",
  "has_javaagent": true,
  "javaagent_target_versions": [
    "org.apache.kafka:connect-api:[2.6.0,)"
  ],
  "library_link": "https://kafka.apache.org/documentation/#connect",
  "name": "kafka-connect-2.6",
  "scope": {
    "name": "io.opentelemetry.kafka-connect-2.6",
    "schema_url": "https://opentelemetry.io/schemas/1.43.0"
  },
  "semantic_conventions": [
    "MESSAGING_SPANS"
  ],
  "source_path": "instrumentation/kafka/kafka-connect-2.6",
  "telemetry": [
    {
      "metrics": [
        {
          "attributes": [
            {
              "name": "messaging.destination.name",
              "type": "STRING"
            },
            {
              "name": "messaging.destination.partition.id",
              "type": "STRING"
            },
            {
              "name": "messaging.operation.name",
              "type": "STRING"
            },
            {
              "name": "messaging.system",
              "type": "STRING"
            }
          ],
          "data_type": "LONG_SUM",
          "description": "Number of messages that were delivered to the application.",
          "instrument": "counter",
          "name": "messaging.client.consumed.messages",
          "unit": "{message}"
        },
        {
          "attributes": [
            {
              "name": "messaging.destination.name",
              "type": "STRING"
            },
            {
              "name": "messaging.destination.partition.id",
              "type": "STRING"
            },
            {
              "name": "messaging.operation.name",
              "type": "STRING"
            },
            {
              "name": "messaging.system",
              "type": "STRING"
            }
          ],
          "data_type": "HISTOGRAM",
          "description": "Duration of processing operation.",
          "instrument": "histogram",
          "name": "messaging.process.duration",
          "unit": "s"
        }
      ],
      "when": "otel.semconv-stability.preview=messaging"
    }
  ]
}