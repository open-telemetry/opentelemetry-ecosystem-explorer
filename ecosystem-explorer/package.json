{
  "name": "ecosystem-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "trustedDependencies": [
    "@swc/core",
    "esbuild"
  ],
  "scripts": {
    "serve": "vite",
    "build": "tsc -b && bun run generate-schemas && vite build && bun scripts/generate-agent-docs.mjs && bun scripts/generate-seo.mjs",
    "generate-schemas": "bun scripts/generate-schemas.mjs && prettier --write public/schemas --ignore-path ../.prettierignore",
    "generate-agent-docs": "bun scripts/generate-agent-docs.mjs",
    "generate-seo": "bun scripts/generate-seo.mjs",
    "netlify-build:preview": "tsc -b && bun run generate-schemas && vite build && bun scripts/generate-agent-docs.mjs && bun scripts/generate-seo.mjs",
    "netlify-build:production": "tsc -b && bun run generate-schemas && vite build && bun scripts/generate-agent-docs.mjs && bun scripts/generate-seo.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "screenshots:capture": "bun scripts/take-screenshots.mjs",
    "screenshots:diff": "bun scripts/diff-screenshots.mjs"
  },
  "dependencies": {
    "@grafana/faro-react": "2.10.0",
    "@grafana/faro-web-tracing": "2.10.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "cmdk": "1.1.1",
    "i18next": "26.4.0",
    "idb": "8.0.3",
    "js-yaml": "5.3.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "26.2.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "pixelmatch": "7.2.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "typescript-json-schema": "0.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
